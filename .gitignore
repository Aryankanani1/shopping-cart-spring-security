# Maven
target/
!**/src/main/**/target/
!**/src/test/**/target/
.mvn/wrapper/maven-wrapper.jar

# Environment / secrets — NEVER commit these
.env
.env.*
!.env.example

# Application config: base application.yml + application-{dev,prod}.yml are
# committed (safe defaults only; secrets come from the environment).
# Legacy .properties and personal local overrides stay OUT of the repo.
src/main/resources/application.properties
src/main/resources/application-*.properties
src/main/resources/application-local.yml

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Spring Tool Suite
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# VS Code
.vscode/

# macOS
.DS_Store

# Logs
*.log

# Personal notes (served publicly from static/ — keep out of the repo)
src/main/resources/static/notes.*
