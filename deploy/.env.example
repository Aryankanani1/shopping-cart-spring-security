# Production settings for deploy/docker-compose.yml. Copy to deploy/.env on the
# server (git-ignored) and fill in every value. Secrets stay empty here: this
# file is public.

# The shop's domain. Its DNS must point at this server, with ports 80 and 443
# open, for Caddy to get the HTTPS certificate.
SITE_ADDRESS=shop.example.com

# Which published images to run: a commit SHA from the publish workflow, or latest.
IMAGE_TAG=latest

# The managed MySQL 8 database. Require TLS with certificate checks, e.g.
#   jdbc:mysql://db.example.com:3306/shop?sslMode=VERIFY_IDENTITY
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# JWT signing key: openssl rand -base64 32
JWT_SECRET=

# First start only: this account is created as the admin. Remove ADMIN_PASSWORD
# once it exists; the account keeps its password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0
# HTTP_PORT=80
# HTTPS_PORT=443
