# ===========================================================================
# Example environment for docker-compose (LOCAL DEV).
# Copy to .env — which is git-ignored — before running:
#
#     cp .env.example .env
#
# docker compose automatically loads .env for ${VAR} substitution. Every value
# here has a safe default in docker-compose.yml, EXCEPT JWT_SECRET, which you
# must generate (see below).
# ===========================================================================

# --- MySQL image tag (pinned; bump deliberately) ---
MYSQL_VERSION=8.4

# --- Database (DEV credentials — change for anything that isn't throwaway) ---
DB_NAME=shopping_cart
DB_USERNAME=shop          # must NOT be "root" (the MySQL image rejects that)
DB_PASSWORD=shop
DB_ROOT_PASSWORD=root
DB_PORT=3306              # host port to reach MySQL (container port is always 3306)

# --- Application ---
SPRING_PROFILES_ACTIVE=dev
APP_PORT=8080             # host port to reach the API (container port is always 8080)
JAVA_OPTS=                # optional JVM flags, e.g. -XX:MaxRAMPercentage=75.0

# --- JWT signing key (REQUIRED) ---
# Base64, >= 256 bits for HS256. Generate your own and paste it here:
#     openssl rand -base64 32
# Empty on purpose: whoever knows the key can sign a token for any account,
# admins included, and this file is public. docker compose won't start without it.
JWT_SECRET=

# --- Prometheus and Grafana (optional) ---
# To run them next to the app:  docker compose --profile monitoring up
# It scrapes /actuator/prometheus with a dedicated account (HTTP Basic). Set
# ENABLED=true and a password of 16-72 characters, e.g.:
#     openssl rand -base64 24
# With ENABLED=false the endpoint stays admin-only, like the rest of /actuator.
PROMETHEUS_SCRAPE_ENABLED=false
PROMETHEUS_SCRAPE_PASSWORD=
PROMETHEUS_PORT=9090      # host port for the Prometheus UI (localhost only)
# Grafana's "admin" password, used when Grafana first starts (openssl rand -base64 24).
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000         # host port for Grafana (localhost only)
