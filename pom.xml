<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- The parent of every module: Spring Boot's dependency and plugin management,
	     the versions of the libraries Boot doesn't manage, and the module list.
	     One Maven module per feature module (see the README's Architecture), plus
	     shop-app, which assembles them into the runnable application. -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.aryan</groupId>
	<artifactId>shopping-cart</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>shopping-cart</name>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>

	<!-- Dependencies point one way, so this is also a valid build order. -->
	<modules>
		<module>shop-common</module>
		<module>shop-identity</module>
		<module>shop-catalog</module>
		<module>shop-cart</module>
		<module>shop-order</module>
		<module>shop-notification</module>
		<module>shop-wishlist</module>
		<module>shop-app</module>
	</modules>

	<properties>
		<java.version>17</java.version>
		<!-- Versions of the libraries the Spring Boot BOM (from the parent) doesn't
		     manage. Each is set once here and applied by dependencyManagement below;
		     no <dependency> in any module declares a version of its own. -->
		<jjwt.version>0.12.5</jjwt.version>
		<shedlock.version>7.10.1</shedlock.version>
		<springdoc-openapi.version>3.1.0</springdoc-openapi.version>
		<modelmapper.version>3.2.4</modelmapper.version>
		<!-- Not 13.0.0: it sends an empty NVD API key when none is set, so its
		     update fails without a key (dependency-check/DependencyCheck#8715, fixed
		     after 13.0.0). Dependabot skips 13.0.0 and will offer the next 13.x. -->
		<dependency-check.version>12.2.2</dependency-check.version>
		<jacoco.version>0.8.15</jacoco.version>
		<!-- Not used, but part of Maven's default lifecycles, so pinned like every
		     other plugin (the Enforcer's requirePluginVersions). -->
		<maven-site-plugin.version>3.22.0</maven-site-plugin.version>

		<!-- Overrides of versions the Spring Boot BOM manages, each for CVEs its
		     version still has. Remove each one once Spring Boot's own version is at
		     least the one set here. -->
		<!-- Tomcat (spring-boot-starter-tomcat): Boot 4.1.1's 11.0.24 still has
		     CVE-2026-65183, CVE-2026-66422, CVE-2026-68763, CVE-2026-65182,
		     CVE-2026-65905, CVE-2026-65927, CVE-2026-68525, CVE-2026-68569 and
		     CVE-2026-65637, all fixed in 11.0.25. -->
		<tomcat.version>11.0.26</tomcat.version>
		<!-- MySQL Connector/J (runtime driver): Boot's 9.7.0 has CVE-2026-60586 and
		     CVE-2026-60623 (9.7.0-9.7.1). 26.7.0 is the release after 9.7; Oracle
		     numbers releases by year and month since then. -->
		<mysql.version>26.7.0</mysql.version>
		<!-- spring-boot:run only starts shop-app; the library modules have no main
		     class, so `./mvnw -pl shop-app -am spring-boot:run` skips them. -->
		<spring-boot.run.skip>true</spring-boot.run.skip>
	</properties>

	<!-- A library's own BOM keeps all of its modules on one version, the way the
	     parent's Spring Boot BOM does for Spring, Hibernate, Jackson, MySQL and the
	     rest. Careful: a BOM imported here is resolved before the BOMs the Boot BOM
	     imports itself (Jackson's among them), so it can override their versions.
	     After adding or changing one, compare `./mvnw dependency:list` before and
	     after; only the intended artifacts should move. -->
	<dependencyManagement>
		<dependencies>
			<!-- This project's modules -->
			<dependency>
				<groupId>com.aryan</groupId>
				<artifactId>shop-common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.aryan</groupId>
				<artifactId>shop-identity</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.aryan</groupId>
				<artifactId>shop-catalog</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.aryan</groupId>
				<artifactId>shop-cart</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.aryan</groupId>
				<artifactId>shop-order</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.aryan</groupId>
				<artifactId>shop-notification</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.aryan</groupId>
				<artifactId>shop-wishlist</artifactId>
				<version>${project.version}</version>
			</dependency>

			<dependency>
				<groupId>net.javacrumbs.shedlock</groupId>
				<artifactId>shedlock-bom</artifactId>
				<version>${shedlock.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-bom</artifactId>
				<version>${springdoc-openapi.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- JJWT is listed module by module rather than through jjwt-bom: that BOM
			     inherits jjwt-root's pin of jackson-databind 2.12.7.1, which Maven
			     imports with it, and it overrides the Boot BOM's Jackson 2 (2.21.x) used
			     by springdoc and jjwt-jackson. -->
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-api</artifactId>
				<version>${jjwt.version}</version>
			</dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-impl</artifactId>
				<version>${jjwt.version}</version>
			</dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-jackson</artifactId>
				<version>${jjwt.version}</version>
			</dependency>

			<!-- A single artifact; ModelMapper publishes no BOM. -->
			<dependency>
				<groupId>org.modelmapper</groupId>
				<artifactId>modelmapper</artifactId>
				<version>${modelmapper.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- Inherited by every module: build-time helpers that are not passed on to
	     dependents (optional), and the unit-test stack. -->
	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<!-- Generates config metadata so @ConfigurationProperties keys get IDE
		     autocomplete/docs. Compile-time only; not shipped in the jar. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-configuration-processor</artifactId>
			<optional>true</optional>
		</dependency>
		<!-- JUnit, Mockito, AssertJ and Spring's test support for each module's unit
		     tests. Tests that need the application context live in shop-app. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Rules every build has to meet, checked first (validate phase). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-build-rules</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireMavenVersion>
									<version>[3.9,)</version>
								</requireMavenVersion>
								<requireJavaVersion>
									<version>[17,)</version>
								</requireJavaVersion>
								<!-- A reproducible build: every plugin at a fixed version (most
								     come from the Spring Boot parent), and only released
								     dependencies, apart from this project's own modules. -->
								<requirePluginVersions/>
								<requireReleaseDeps>
									<excludes>
										<exclude>com.aryan:*</exclude>
									</excludes>
								</requireReleaseDeps>
								<banDuplicatePomDependencyVersions/>
								<dependencyConvergence/>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Code coverage: every module's tests run with the JaCoCo agent, which
			     writes target/jacoco.exec (CI writes jacoco-unit.exec and jacoco-it.exec
			     instead, one per test stage). shop-app merges them into one report for
			     all modules on `verify`; the quality gate in CI reads that report. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<!-- Every javac lint check, and a warning fails the build (main and test
				     code). Two are off: `serial`, as nothing here is Java-serialized
				     (exceptions and UserDetails are Serializable only through their
				     supertypes); and `processing`, which lists every annotation the
				     Lombok and configuration-metadata processors don't handle. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<showWarnings>true</showWarnings>
						<failOnWarning>true</failOnWarning>
						<compilerArgs>
							<arg>-Xlint:all,-serial,-processing</arg>
						</compilerArgs>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>${jacoco.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-site-plugin</artifactId>
					<version>${maven-site-plugin.version}</version>
				</plugin>
				<!-- OWASP Dependency-Check compares the dependencies of every module with
				     the NVD's list of CVEs: `./mvnw -DskipTests package dependency-check:aggregate`
				     (`package` first, so it finds the project's own modules as jars), which
				     CI runs on every push and pull request. It fails on a finding with
				     CVSS 7 or above (HIGH or CRITICAL); CLAUDE.md says how to fix one. The
				     first run downloads the NVD database, which takes a few minutes with an
				     API key in NVD_API_KEY and about an hour without one (an unset or empty
				     NVD_API_KEY means no key); later runs only fetch what changed. The
				     report is target/dependency-check-report.html. -->
				<plugin>
					<groupId>org.owasp</groupId>
					<artifactId>dependency-check-maven</artifactId>
					<version>${dependency-check.version}</version>
					<configuration>
						<failBuildOnCVSS>7</failBuildOnCVSS>
						<nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
						<!-- False positives only, each with the CVE and the reason in <notes>. -->
						<suppressionFiles>
							<suppressionFile>${maven.multiModuleProjectDirectory}/dependency-check-suppressions.xml</suppressionFile>
						</suppressionFiles>
						<formats>
							<format>HTML</format>
							<format>JSON</format>
						</formats>
						<!-- Maven already names every artifact, so the lookup on Maven Central
						     adds nothing but a rate-limited network call; Sonatype OSS Index
						     needs an account. The frontend is scanned by `npm audit`, and
						     there is no .NET code. -->
						<centralAnalyzerEnabled>false</centralAnalyzerEnabled>
						<ossIndexAnalyzerEnabled>false</ossIndexAnalyzerEnabled>
						<nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
						<nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
						<retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
						<assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
						<nuspecAnalyzerEnabled>false</nuspecAnalyzerEnabled>
						<nugetconfAnalyzerEnabled>false</nugetconfAnalyzerEnabled>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>
