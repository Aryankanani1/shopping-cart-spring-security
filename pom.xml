<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.aryan</groupId>
	<artifactId>shoppingCartWithSpringSecurity</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>17</java.version>
		<!-- Versions of the libraries the Spring Boot BOM (from the parent) doesn't
		     manage. Each is set once here and applied by dependencyManagement below;
		     no <dependency> in this file declares a version of its own. -->
		<jjwt.version>0.12.5</jjwt.version>
		<shedlock.version>7.10.1</shedlock.version>
		<springdoc-openapi.version>3.1.0</springdoc-openapi.version>
		<modelmapper.version>3.2.4</modelmapper.version>
	</properties>

	<!-- A library's own BOM keeps all of its modules on one version, the way the
	     parent's Spring Boot BOM does for Spring, Hibernate, Jackson, MySQL and the
	     rest. Careful: a BOM imported here is resolved before the BOMs the Boot BOM
	     imports itself (Jackson's among them), so it can override their versions.
	     After adding or changing one, compare `./mvnw dependency:list` before and
	     after; only the intended artifacts should move. -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>net.javacrumbs.shedlock</groupId>
				<artifactId>shedlock-bom</artifactId>
				<version>${shedlock.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-bom</artifactId>
				<version>${springdoc-openapi.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- JJWT is listed module by module rather than through jjwt-bom: that BOM
			     inherits jjwt-root's pin of jackson-databind 2.12.7.1, which Maven
			     imports with it, and it overrides the Boot BOM's Jackson 2 (2.21.x) used
			     by springdoc and jjwt-jackson. -->
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-api</artifactId>
				<version>${jjwt.version}</version>
			</dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-impl</artifactId>
				<version>${jjwt.version}</version>
			</dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-jackson</artifactId>
				<version>${jjwt.version}</version>
			</dependency>

			<!-- A single artifact; ModelMapper publishes no BOM. -->
			<dependency>
				<groupId>org.modelmapper</groupId>
				<artifactId>modelmapper</artifactId>
				<version>${modelmapper.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- TransactionAwareCacheManagerProxy (CacheConfig): cache evictions apply on commit. -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context-support</artifactId>
		</dependency>

		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Health/readiness/liveness probes, build info and metrics for ops. Only
		     /actuator/health is public; the rest is admin-only (see ShopConfig). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Prometheus format for the metrics, served at /actuator/prometheus. Who may
		     scrape it: see PrometheusScrapeSecurityConfig. Version from the Boot BOM. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<!-- Versioned, repeatable schema migrations own the DDL in prod (ddl-auto:
		     validate). Boot 4 modularised the autoconfiguration: the starter pulls
		     both flyway-core AND the spring-boot-flyway autoconfig module (raw
		     flyway-core alone leaves Flyway inert — it never runs at startup).
		     flyway-mysql adds the MySQL 8 database type. Versions from the BOM. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-mysql</artifactId>
		</dependency>

		<!-- Distributed lock for @Scheduled tasks: guarantees the critical
		     refresh-token purge runs on only one node at a time (see
		     RefreshTokenCleanupService + SchedulingConfig). The JDBC provider
		     stores the lock in a `shedlock` table (created by Flyway V2). -->
		<dependency>
			<groupId>net.javacrumbs.shedlock</groupId>
			<artifactId>shedlock-spring</artifactId>
		</dependency>
		<dependency>
			<groupId>net.javacrumbs.shedlock</groupId>
			<artifactId>shedlock-provider-jdbc-template</artifactId>
		</dependency>

		<!-- Bean Validation (JSR-380) — powers @Validated on @ConfigurationProperties. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- AspectJ weaver — supplies the @Aspect/@Around annotations for the
		     service-layer logging aspect (LoggingAspect). spring-aop itself is
		     already on the classpath via spring-context; Boot 4's BOM manages the
		     aspectjweaver version (Boot 4 no longer ships spring-boot-starter-aop).
		     Auto-proxying is switched on explicitly by AopConfig. -->
		<dependency>
			<groupId>org.aspectj</groupId>
			<artifactId>aspectjweaver</artifactId>
		</dependency>

		<!-- YAML config support (application.yml). Spring Boot 4 no longer pulls
		     SnakeYAML transitively, so declare it explicitly; version from the BOM. -->
		<dependency>
			<groupId>org.yaml</groupId>
			<artifactId>snakeyaml</artifactId>
		</dependency>

		<!-- Generates config metadata so @ConfigurationProperties keys get IDE
		     autocomplete/docs. Compile-time only; not shipped in the jar. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-configuration-processor</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- @DataJpaTest slice: repository/JPA-only tests (TestEntityManager,
		     AutoConfigureTestDatabase). Boot 4 splits the test slices into
		     per-module artifacts; this starter aggregates the data-jpa ones. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- In-memory database for the end-to-end journey tests, so they run in CI
		     without a live MySQL. Version managed by the Spring Boot BOM. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.modelmapper</groupId>
			<artifactId>modelmapper</artifactId>
		</dependency>

		<!-- OpenAPI 3 + Swagger UI (springdoc). The 3.x line targets Spring Boot 4 /
		     Spring Framework 7. Serves the spec at /v3/api-docs and the UI at
		     /swagger-ui.html. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
		</dependency>

		<!-- JWT signing and parsing. The code compiles against jjwt-api only; the
		     implementation and its Jackson serializer are runtime-only, as JJWT
		     recommends, so nothing can come to depend on their internals. -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<scope>runtime</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<!-- Writes META-INF/build-info.properties, which /actuator/info
					     shows as the app's version and build time. -->
					<execution>
						<goals>
							<goal>build-info</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
