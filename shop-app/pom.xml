<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.aryan</groupId>
		<artifactId>shopping-cart</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>shop-app</artifactId>
	<description>The runnable application: the main class and its module list, configuration, Flyway migrations, and the tests that need the whole application.</description>

	<properties>
		<!-- The one module with a main class. -->
		<spring-boot.run.skip>false</spring-boot.run.skip>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.aryan</groupId>
			<artifactId>shop-common</artifactId>
		</dependency>
		<dependency>
			<groupId>com.aryan</groupId>
			<artifactId>shop-identity</artifactId>
		</dependency>
		<dependency>
			<groupId>com.aryan</groupId>
			<artifactId>shop-catalog</artifactId>
		</dependency>
		<dependency>
			<groupId>com.aryan</groupId>
			<artifactId>shop-cart</artifactId>
		</dependency>
		<dependency>
			<groupId>com.aryan</groupId>
			<artifactId>shop-order</artifactId>
		</dependency>
		<dependency>
			<groupId>com.aryan</groupId>
			<artifactId>shop-notification</artifactId>
		</dependency>
		<dependency>
			<groupId>com.aryan</groupId>
			<artifactId>shop-wishlist</artifactId>
		</dependency>
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Health/readiness/liveness probes, build info and metrics. Only /actuator/health is
		     public; the rest is admin-only (see ShopConfig). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Prometheus format for the metrics at /actuator/prometheus (see PrometheusScrapeSecurityConfig). -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<!-- Versioned migrations own the DDL (ddl-auto: validate). Boot 4 needs the starter, not
		     just flyway-core, for Flyway to run at startup; flyway-mysql adds MySQL 8. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-mysql</artifactId>
		</dependency>
		<!-- application.yml support; Boot 4 no longer pulls SnakeYAML in on its own. -->
		<dependency>
			<groupId>org.yaml</groupId>
			<artifactId>snakeyaml</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- @DataJpaTest slices (Boot 4 splits the test slices into per-module artifacts). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- MySQL in a container for the integration tests (test profile): the same
		     database, driver and Flyway migrations as dev and production. Needs Docker. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-mysql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<!-- Writes META-INF/build-info.properties, which /actuator/info
					     shows as the app's version and build time. -->
					<execution>
						<goals>
							<goal>build-info</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- One coverage report for the whole backend: every module's classes, with
			     the coverage from each module's own tests and from shop-app's (which
			     exercise all modules). Merges every target/*.exec it finds. Report in
			     target/site/jacoco-aggregate/ (index.html, jacoco.xml). -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>report-aggregate</id>
						<phase>verify</phase>
						<goals>
							<goal>report-aggregate</goal>
						</goals>
						<configuration>
							<includeCurrentProject>true</includeCurrentProject>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
