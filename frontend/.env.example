# Origin of the Spring API. Leave EMPTY for local dev — the Vite proxy in
# vite.config.ts forwards /api to http://localhost:8080 (same-origin, no CORS).
#
# In production, either serve this build from the same host as the API and leave
# this empty, or point it at the API origin, e.g.
#   VITE_API_BASE_URL=https://api.example.com
# and list this site's origin in the API's APP_CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=
