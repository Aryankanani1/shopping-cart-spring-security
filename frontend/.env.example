# Origin of the Spring API. Leave EMPTY for local dev — the Vite proxy in
# vite.config.ts forwards /api to http://localhost:8080 (same-origin, no CORS).
#
# In production, point this at the real API origin, e.g.
#   VITE_API_BASE_URL=https://api.example.com
# and make sure that origin sends CORS headers for this site (or serve this
# build from the same host as the API).
VITE_API_BASE_URL=
