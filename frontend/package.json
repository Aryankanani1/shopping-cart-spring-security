{
  "name": "shopping-cart-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Customer storefront for the Spring Security shopping-cart API",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
