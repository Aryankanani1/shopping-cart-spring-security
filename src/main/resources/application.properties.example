spring.application.name=spring_security_demo

# Base path prefix for all REST controllers (e.g. /api/v1/products).
api.prefix=/api/v1

# ---------------------------------------------------------------------------
# DataSource
# ---------------------------------------------------------------------------
spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ---------------------------------------------------------------------------
# Connection pool (HikariCP) — size it to the DB's real capacity, not "big".
# pool-size ~ ((core_count * 2) + effective_spindle_count) is a good baseline.
# ---------------------------------------------------------------------------
spring.datasource.hikari.pool-name=ShoppingCartHikariPool
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.idle-timeout=600000
spring.datasource.hikari.max-lifetime=1800000
# Fail fast rather than let a leaked connection hide for ever.
spring.datasource.hikari.leak-detection-threshold=20000

# ---------------------------------------------------------------------------
# JPA / Hibernate
# ---------------------------------------------------------------------------
spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# Close the persistence context at the service/transaction boundary instead of
# holding it open for the whole request. This surfaces LazyInitializationException
# at development time and prevents hidden N+1 queries during JSON serialization,
# forcing associations to be fetched explicitly (e.g. JOIN FETCH / @EntityGraph).
spring.jpa.open-in-view=false

# Global batch fetching — turns a would-be N+1 on lazy associations into a
# single IN (...) query. Complements the per-collection @BatchSize hints.
spring.jpa.properties.hibernate.default_batch_fetch_size=20

# Batch writes: group INSERT/UPDATE/DELETE into JDBC batches. This works because
# entities use GenerationType.SEQUENCE with a pooled optimizer (allocationSize=50),
# so Hibernate assigns ids up-front instead of round-tripping per row like IDENTITY.
spring.jpa.properties.hibernate.jdbc.batch_size=20
spring.jpa.properties.hibernate.order_inserts=true
spring.jpa.properties.hibernate.order_updates=true
spring.jpa.properties.hibernate.batch_versioned_data=true

# ---------------------------------------------------------------------------
# SQL logging — DEVELOPMENT ONLY. Keep these off in production.
# Set the BasicBinder logger to TRACE to also see bound parameter values, and
# watch the SQL statement logs to catch N+1 problems early.
# ---------------------------------------------------------------------------
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.use_sql_comments=true
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.orm.jdbc.bind=TRACE
# Logs a warning whenever a query triggers a pagination-in-memory / cartesian risk.
logging.level.org.hibernate.orm.query=WARN

# ---------------------------------------------------------------------------
# JWT (see JwtUtils) — required for the app to start; keep the real secret OUT
# of source control (provide it via the JWT_SECRET environment variable).
# jwtSecret must be a Base64-encoded key of at least 256 bits (32 bytes) for
# HS256. Generate one with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
auth.token.jwtSecret=${JWT_SECRET}
# Token lifetime in milliseconds (e.g. 3600000 = 1 hour).
auth.token.expirationInMils=${JWT_EXPIRATION_MS:3600000}
